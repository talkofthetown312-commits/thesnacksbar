{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Menu item in Talk of the Town POS",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "active": { "type": "boolean" },
        "isAvailable": { "type": "boolean" },
        "recipeId": { "type": "string" }
      },
      "required": ["id", "name", "category", "price", "active"]
    },
    "MenuItemSize": {
      "title": "MenuItemSize",
      "description": "Size variant for a menu item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "item_id": { "type": "string" },
        "size": { "type": "string", "enum": ["Small", "Medium", "Large", "Standard"] },
        "price": { "type": "number" },
        "cost_price": { "type": "number" },
        "active": { "type": "boolean" }
      },
      "required": ["item_id", "size", "price", "active"]
    },
    "InventoryItem": {
      "title": "InventoryItem",
      "description": "Master inventory item (TOT-001 through TOT-144)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sku": { "type": "string" },
        "name": { "type": "string" },
        "categoryId": { "type": "string" },
        "unit": { "type": "string" },
        "currentStock": { "type": "number" },
        "reorderLevel": { "type": "number" },
        "minimumStock": { "type": "number" },
        "costPrice": { "type": "number" },
        "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE", "DISCONTINUED"] }
      },
      "required": ["id", "name", "categoryId", "unit", "currentStock", "status"]
    },
    "StockTransaction": {
      "title": "StockTransaction",
      "description": "Atomic inventory stock movement record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "itemId": { "type": "string" },
        "type": { "type": "string" },
        "quantity": { "type": "number" },
        "unitCost": { "type": "number" },
        "totalCost": { "type": "number" },
        "referenceId": { "type": "string" },
        "date": { "type": "string" },
        "performedBy": { "type": "string" }
      },
      "required": ["id", "itemId", "type", "quantity", "date"]
    },
    "Recipe": {
      "title": "Recipe",
      "description": "Dish recipe and Bill of Materials (BOM)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "productId": { "type": "string" },
        "yieldQuantity": { "type": "number" },
        "yieldUnit": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "name", "yieldQuantity", "yieldUnit"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order in POS",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string" },
        "orderType": { "type": "string", "enum": ["DINE_IN", "TAKEAWAY", "DELIVERY"] },
        "tableNumber": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "subtotal": { "type": "number" },
        "discountAmount": { "type": "number" },
        "tax": { "type": "number" },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["CASH", "UPI", "CARD", "SPLIT"] },
        "status": { "type": "string", "enum": ["PENDING", "PAID", "CANCELLED", "REFUNDED"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "orderNumber", "subtotal", "tax", "total", "status"]
    },
    "Ticket": {
      "title": "Ticket",
      "description": "KDS / KOT ticket for kitchen",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderId": { "type": "string" },
        "orderNumber": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "orderId", "orderNumber", "status"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with roles and permissions",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "roles": { "type": "array", "items": { "type": "string" } },
        "permissions": { "type": "array", "items": { "type": "string" } },
        "branches": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "roles", "permissions"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User accounts and role permissions"
    },
    "/pos_products/{productId}": {
      "schema": "Product",
      "description": "Active and archived menu items"
    },
    "/menu_item_sizes/{sizeId}": {
      "schema": "MenuItemSize",
      "description": "Size variants for menu items"
    },
    "/inventory_items/{itemId}": {
      "schema": "InventoryItem",
      "description": "144 Master inventory items"
    },
    "/inventory_transactions/{txnId}": {
      "schema": "StockTransaction",
      "description": "Stock in/out/adjustment transactions"
    },
    "/manufacturing_recipes/{recipeId}": {
      "schema": "Recipe",
      "description": "Approved Talk of the Town recipes and BOMs"
    },
    "/pos_orders/{orderId}": {
      "schema": "Order",
      "description": "Point of sale orders"
    },
    "/tickets/{ticketId}": {
      "schema": "Ticket",
      "description": "Kitchen Display System tickets"
    }
  }
}
